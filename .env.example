# Database
DATABASE_URL=postgresql+asyncpg://copilot:copilot@localhost:5432/interview_pilot
DATABASE_URL_SYNC=postgresql://copilot:copilot@localhost:5432/interview_pilot

# Redis
REDIS_URL=redis://localhost:6379/0

# Auth
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/callback
# Sign-in allowlist (comma-separated; empty = anyone, development only) and admins
ALLOWED_LOGIN_EMAILS=
ALLOWED_LOGIN_DOMAINS=
ADMIN_EMAILS=

# LLM Providers
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Deepgram
DEEPGRAM_API_KEY=

# Storage (MinIO)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=interview-pilot

# App
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
ENVIRONMENT=development
LOG_LEVEL=DEBUG
