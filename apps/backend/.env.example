# Backend settings. Copy to apps/backend/.env (read from the directory the backend
# starts in). Every variable needs the INTERVIEW_PILOT_ prefix; see src/config.py.

# Database
INTERVIEW_PILOT_DATABASE_URL=postgresql+asyncpg://copilot:copilot@localhost:5432/interview_pilot
INTERVIEW_PILOT_DATABASE_URL_SYNC=postgresql://copilot:copilot@localhost:5432/interview_pilot

# Redis
INTERVIEW_PILOT_REDIS_URL=redis://localhost:6379/0

# Auth
INTERVIEW_PILOT_JWT_SECRET_KEY=change-me-in-production
INTERVIEW_PILOT_JWT_ALGORITHM=HS256
INTERVIEW_PILOT_JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
INTERVIEW_PILOT_JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
INTERVIEW_PILOT_GOOGLE_CLIENT_ID=
INTERVIEW_PILOT_GOOGLE_CLIENT_SECRET=
INTERVIEW_PILOT_GOOGLE_REDIRECT_URI=http://interviewpilot.localhost:5173/auth/callback
# Sign-in allowlist (comma-separated; empty = anyone, development only) and admins
INTERVIEW_PILOT_ALLOWED_LOGIN_EMAILS=
INTERVIEW_PILOT_ALLOWED_LOGIN_DOMAINS=
INTERVIEW_PILOT_ADMIN_EMAILS=
# Lifetime of the per-session token the dashboard hands to the extension
INTERVIEW_PILOT_PAIRING_TOKEN_EXPIRE_HOURS=6

# Local sign-in without Google: run the fake provider
#   cd apps/backend && PYTHONPATH=. uv run python -m tests.fake_oidc --port 9400 --email you@example.com
# and uncomment these (they replace the Google settings above).
# INTERVIEW_PILOT_GOOGLE_CLIENT_ID=test-client-id
# INTERVIEW_PILOT_GOOGLE_CLIENT_SECRET=fake
# INTERVIEW_PILOT_OIDC_ISSUER=http://localhost:9400
# INTERVIEW_PILOT_OIDC_AUTHORIZATION_URL=http://localhost:9400/authorize
# INTERVIEW_PILOT_OIDC_TOKEN_URL=http://localhost:9400/token
# INTERVIEW_PILOT_OIDC_JWKS_URL=http://localhost:9400/jwks

# LLM providers. With neither key, a mock provider answers (development only);
# with one, it serves every task.
INTERVIEW_PILOT_ANTHROPIC_API_KEY=
INTERVIEW_PILOT_OPENAI_API_KEY=
# Without keys: "mock" (canned answers) or "scripted" (deterministic, input-sensitive)
INTERVIEW_PILOT_DEV_LLM_PROVIDER=mock

# Deepgram (transcription)
INTERVIEW_PILOT_DEEPGRAM_API_KEY=

# Live-session features (off by default)
INTERVIEW_PILOT_PEER_INTERVIEWER_ENABLED=false
INTERVIEW_PILOT_AGENTIC_ROUTING_ENABLED=false
INTERVIEW_PILOT_REPORT_AGENTIC_SCORING=false

# Storage (MinIO)
INTERVIEW_PILOT_S3_ENDPOINT=http://localhost:9000
INTERVIEW_PILOT_S3_ACCESS_KEY=minioadmin
INTERVIEW_PILOT_S3_SECRET_KEY=minioadmin
INTERVIEW_PILOT_S3_BUCKET=interview-pilot

# App
INTERVIEW_PILOT_BACKEND_URL=http://localhost:8000
INTERVIEW_PILOT_FRONTEND_URL=http://interviewpilot.localhost:5173
INTERVIEW_PILOT_ENVIRONMENT=development
INTERVIEW_PILOT_LOG_LEVEL=DEBUG
# Development only: API calls without a token act as a seeded dev user
INTERVIEW_PILOT_DEV_MODE=true
