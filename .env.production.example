# =============================================================================
# Interview Pilot — Production Environment Variables
# Copy to .env.production and fill in real values
# =============================================================================

# --- Infrastructure Passwords (used by docker-compose.prod.yml) ---
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here
MINIO_ROOT_USER=CHANGE_ME_minio_user
MINIO_ROOT_PASSWORD=CHANGE_ME_minio_password

# --- Backend Settings (INTERVIEW_PILOT_ prefix, read by FastAPI) ---

# Database
INTERVIEW_PILOT_DATABASE_URL=postgresql+asyncpg://copilot:CHANGE_ME_strong_password_here@postgres:5432/interview_pilot
INTERVIEW_PILOT_DATABASE_URL_SYNC=postgresql://copilot:CHANGE_ME_strong_password_here@postgres:5432/interview_pilot

# Redis (no auth — internal Docker network only)
INTERVIEW_PILOT_REDIS_URL=redis://redis:6379/0

# Auth
INTERVIEW_PILOT_JWT_SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32
INTERVIEW_PILOT_JWT_ALGORITHM=HS256
INTERVIEW_PILOT_JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
INTERVIEW_PILOT_JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
INTERVIEW_PILOT_GOOGLE_CLIENT_ID=
INTERVIEW_PILOT_GOOGLE_CLIENT_SECRET=
INTERVIEW_PILOT_GOOGLE_REDIRECT_URI=https://interviewpilot.duckdns.org/auth/callback

# LLM Providers (at least one required)
INTERVIEW_PILOT_ANTHROPIC_API_KEY=
INTERVIEW_PILOT_OPENAI_API_KEY=

# Deepgram (required for live transcription)
INTERVIEW_PILOT_DEEPGRAM_API_KEY=

# Storage (MinIO — internal Docker network)
INTERVIEW_PILOT_S3_ENDPOINT=http://minio:9000
INTERVIEW_PILOT_S3_ACCESS_KEY=CHANGE_ME_minio_user
INTERVIEW_PILOT_S3_SECRET_KEY=CHANGE_ME_minio_password
INTERVIEW_PILOT_S3_BUCKET=interview-pilot

# App
INTERVIEW_PILOT_BACKEND_URL=https://interviewpilot.duckdns.org
INTERVIEW_PILOT_FRONTEND_URL=https://interviewpilot.duckdns.org
INTERVIEW_PILOT_ENVIRONMENT=production
INTERVIEW_PILOT_LOG_LEVEL=INFO
