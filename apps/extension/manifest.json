{
  "manifest_version": 3,
  "name": "InterviewPilot",
  "version": "0.1.0",
  "description": "AI-Powered Real-Time Interview Assistant — Audio & Code Capture",
  "permissions": [
    "tabCapture",
    "activeTab",
    "scripting",
    "storage",
    "sidePanel",
    "offscreen"
  ],
  "host_permissions": [
    "https://meet.google.com/*",
    "https://*.zoom.us/*",
    "https://teams.microsoft.com/*",
    "https://*.coderpad.io/*",
    "https://*.hackerrank.com/*",
    "https://*.leetcode.com/*",
    "http://interviewpilot.localhost:5173/*",
    "http://localhost:5173/*",
    "http://localhost:8000/*",
    "https://interviewpilot.duckdns.org/*"
  ],
  "background": {
    "service_worker": "dist/background/service-worker.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "dist/src/sidepanel/index.html"
  },
  "action": {
    "default_popup": "dist/src/popup/index.html"
  },
  "commands": {
    "start-capture": {
      "suggested_key": { "default": "Alt+Shift+I" },
      "description": "Start tab audio and microphone capture on this tab"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.coderpad.io/*",
        "https://*.hackerrank.com/*",
        "https://*.leetcode.com/*"
      ],
      "js": ["dist/content/code-scraper.js"]
    }
  ],
  "externally_connectable": {
    "matches": [
      "http://interviewpilot.localhost:5173/*",
      "http://localhost:5173/*",
      "https://interviewpilot.duckdns.org/*"
    ]
  },
  "web_accessible_resources": [
    {
      "resources": ["audio/audio-processor.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
